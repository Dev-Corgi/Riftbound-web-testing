# Public face of the game. riftbound only accepts a Host that is an IP literal
# or "localhost" and a WebSocket Origin equal to "http://<Host>", so we present
# it exactly that.
worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
  access_log off;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 8080;
    __AUTH__
    # Phone-friendly UI (static). It talks to the same /ws as the stock page.
    root /app/mobile;
    location = / { try_files /index.html =404; add_header Cache-Control "no-cache"; }

    # Stock desktop UI, still reachable (the mobile page also reads its card-image table).
    location = /classic {
      proxy_pass http://127.0.0.1:8081/;
      include /etc/nginx/rb_proxy.conf;
    }
    location / {
      proxy_pass http://127.0.0.1:8081;
      include /etc/nginx/rb_proxy.conf;
    }
  }
}
